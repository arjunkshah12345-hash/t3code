---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import HeroHorizon from "../components/islands/HeroHorizon";
import DawnText from "../components/islands/DawnText";
import DawnGlow from "../components/islands/DawnGlow";
import GuardianAscii from "../components/islands/GuardianAscii";
import { GITHUB_REPOSITORY_URL, sitePath } from "../lib/site";
import shotHero from "../assets/shots/05-drumroom.jpg";
import shotComposer from "../assets/shots/02-composer-typed.jpg";
import shotDiff from "../assets/shots/08-diff-open.jpg";
import shotExport from "../assets/shots/03-palette-markdown.jpg";
import shotVillage from "../assets/shots/10-village-toast.jpg";
import shotAlert from "../assets/shots/07-alert-open.jpg";

const agents = [
  { name: "Claude Code", icon: "/harnesses/claude-ai-icon.svg" },
  { name: "Codex", icon: "/harnesses/openai_dark.svg" },
  { name: "Cursor", icon: "/harnesses/cursor_light.svg" },
  { name: "OpenCode", icon: "/harnesses/opencode-dark.svg" },
  { name: "Grok", icon: "/harnesses/grok-dark.svg" },
  { name: "Antigravity", icon: "/harnesses/antigravity.svg" },
];

const faqs = [
  {
    q: "Is this T3 Code?",
    a: "It's a community fork of T3 Code. The workspace underneath is theirs and it's excellent. The wood, the knocks, the village report and the jokes are ours. The original maintainers don't run or endorse this fork, so please don't send them our bugs.",
  },
  {
    q: "What does it cost?",
    a: "Nothing. It's MIT licensed and runs on your machine. You bring your own agent subscriptions (Claude, ChatGPT, Cursor and so on) and keep paying those providers directly. We never see your keys.",
  },
  {
    q: "Does my code leave my machine?",
    a: "Only the way it already does. Your prompts and files go to whichever agent CLI you pick, under that provider's terms. The workspace itself runs locally. Easter-egg progress is kept in local storage and you can reset it.",
  },
  {
    q: "Is there a download?",
    a: "Not yet. For now you build it from source, which takes four commands and a few minutes. Signed desktop builds are on the list. The installers on the original T3 site install upstream T3 Code, not this fork.",
  },
  {
    q: "Which agents work?",
    a: "Claude Code, Codex, Cursor, OpenCode, Grok and Antigravity, through each one's own CLI. Log in to at least one on your machine before you start. You can mix them per thread.",
  },
  {
    q: "Why is the mascot a log with a bat?",
    a: "Tung Tung Tung Sahur is a 2025 meme inspired by the sahur patrol, which goes through Indonesian neighbourhoods during Ramadan knocking on a wooden kentongan to wake people for the pre-dawn meal. Our app does the same for your agents: it knocks when one needs you.",
  },
];
---

<Layout>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-sky" aria-hidden="true"><HeroHorizon client:load /></div>
    <div class="hero-fade" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <a class="yc-pill" href="#faq">
        <span class="yc-mark" aria-hidden="true"><span>Y</span></span>
        <span>Not backed by Y Combinator</span>
        <span class="yc-sep" aria-hidden="true"></span>
        <span class="yc-alt">Backed by one wooden bat</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
      <h1 id="hero-title" class="hero-title">
        Wake every agent<br />
        <DawnText client:load>before dawn.</DawnText>
      </h1>
      <p class="hero-sub">
        Run Claude Code, Codex, Cursor, OpenCode, Grok and Antigravity side by side in one desktop workspace.
        Review every diff, ship the PR, and hear a wooden knock the moment an agent needs you.
      </p>
      <div class="hero-actions">
        <a class="btn" href={sitePath("/download/")}>
          Get started, free
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a class="btn btn-ghost" href="#film">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z" /></svg>
          Watch the 40s tour
        </a>
      </div>
    </div>
    <div class="wrap hero-shot">
      <div class="frame">
        <div class="frame-bar" aria-hidden="true"><i></i><i></i><i></i><span>Tung Tung Tung Code</span></div>
        <Image src={shotHero} widths={[800, 1200, 1800, 2400]} sizes="(max-width: 1240px) 100vw, 1180px" alt="The Tung Tung Tung Code workspace: an agent thread that added a snooze function with tests, the diff panel with two changed files, and the drum room easter egg." loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- Agents -->
  <section class="agents" aria-labelledby="agents-title">
    <div class="wrap">
      <p id="agents-title" class="agents-label mono">Works with the agents you already pay for</p>
      <ul class="agent-row">
        {agents.map((a) => (
          <li><img src={sitePath(a.icon)} alt="" width="22" height="22" loading="lazy" /><span>{a.name}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="section" aria-labelledby="features-title">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">01 / The workspace</p>
        <h2 id="features-title">Serious tools under<br />a very silly hat.</h2>
        <p class="lede">Strip off the wood and it's a fast, opinionated control plane for coding agents. Here is what you actually get.</p>
      </header>
      <div class="bento">
        <article class="card card-wide">
          <div class="card-copy">
            <h3>Every agent, one composer</h3>
            <p>Pick the agent, model, effort and access level per thread. Claude on the refactor, Codex on the tests, no app switching. @ files, $ skills and / commands work everywhere.</p>
          </div>
          <div class="card-shot"><Image src={shotComposer} widths={[700, 1100, 1500]} sizes="(max-width: 900px) 100vw, 720px" alt="The composer with an agent prompt typed in and the model picker." loading="lazy" /></div>
        </article>
        <article class="card card-tall">
          <div class="card-copy">
            <h3>Read the diff before it lands</h3>
            <p>Every turn ends with the files it touched. Open a split or unified diff beside the thread and see exactly what changed, line by line.</p>
          </div>
          <div class="card-shot card-shot-crop"><Image src={shotDiff} widths={[700, 1100]} sizes="(max-width: 900px) 100vw, 460px" alt="A thread with the diff panel open showing changes to alarm.js and its tests." loading="lazy" /></div>
        </article>
        <article class="card">
          <span class="card-icon mono" aria-hidden="true">⌘⏎</span>
          <h3>Commit, push and PR in one go</h3>
          <p>One button commits the work, pushes the branch and opens the pull request. Leave the commit message blank and it writes one for you.</p>
        </article>
        <article class="card">
          <span class="card-icon mono" aria-hidden="true">⑂</span>
          <h3>A worktree per thread</h3>
          <p>Run agents in parallel without them trampling each other's files. Each thread can get its own git worktree and branch.</p>
        </article>
        <article class="card">
          <span class="card-icon mono" aria-hidden="true">◷</span>
          <h3>Scheduled tasks</h3>
          <p>Put an agent on a timer: a nightly dependency check, a morning triage, a weekly cleanup. Each run can get a fresh worktree or use your checkout.</p>
        </article>
        <article class="card">
          <span class="card-icon mono" aria-hidden="true">▤</span>
          <h3>Usage across providers</h3>
          <p>Tokens and rate limits for each subscription in one view, so the limit doesn't sneak up on you mid-refactor.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Film -->
  <section id="film" class="section film" aria-labelledby="film-title">
    <div class="wrap">
      <header class="section-head section-head-center">
        <p class="eyebrow">02 / The tour</p>
        <h2 id="film-title">Forty seconds, one take.</h2>
      </header>
      <div class="frame film-frame">
        <video controls preload="none" playsinline poster={sitePath("/film/poster.jpg")} width="1280" height="720">
          <source src={sitePath("/film/launch-720.mp4")} type="video/mp4" />
          <a href={sitePath("/film/launch-720.mp4")}>Download the launch film (MP4)</a>
        </video>
      </div>
    </div>
  </section>

  <!-- New -->
  <section id="new" class="section" aria-labelledby="new-title">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">03 / New this week</p>
        <h2 id="new-title">Three things that<br />earn their keep.</h2>
      </header>
      <div class="news">
        <article class="news-card">
          <div class="news-shot" style="--fx:50%;--fy:28%"><Image src={shotExport} widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 380px" alt="Command palette showing Copy thread as Markdown and Download thread as Markdown." loading="lazy" /></div>
          <p class="news-k mono">⌘K → Copy thread as Markdown</p>
          <h3>Export any thread</h3>
          <p>Copy or download a whole conversation as clean Markdown, with prompts, replies and tool calls, ready for a PR description, a doc or a bug report.</p>
        </article>
        <article class="news-card">
          <div class="news-shot" style="--fx:97%;--fy:3%;--z:3.2"><Image src={shotVillage} widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 380px" alt="Toast confirming the village report was copied to the clipboard." loading="lazy" /></div>
          <p class="news-k mono">⌘K → Village report</p>
          <h3>Standup, written for you</h3>
          <p>Today's threads, grouped by project in the order you care about: waiting on you, failed, running, done. Paste it into standup and go back to bed.</p>
        </article>
        <article class="news-card">
          <div class="news-shot" style="--fx:76%;--fy:24%"><Image src={shotAlert} widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 380px" alt="Settings, Notifications, Alert sound set to Wooden knocks with a Play button." loading="lazy" /></div>
          <p class="news-k mono">Settings → Notifications → Alert sound</p>
          <h3>It knocks when it needs you</h3>
          <p>One knock when a thread finishes. Tung, tung, TUNG when one needs your input or approval. Bursts coalesce, so ten agents finishing at once is still one knock.</p>
          <div class="knock-demo">
            <button type="button" class="knock-btn" data-knock="completion">▶ Thread finished</button>
            <button type="button" class="knock-btn" data-knock="input">▶ Needs you</button>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Guardian -->
  <section id="guardian" class="section guardian" aria-labelledby="guardian-title">
    <div class="wrap guardian-grid">
      <div class="guardian-art">
        <button id="guardian-knock" type="button" class="guardian-btn" aria-label="Knock on the wooden guardian">
          <GuardianAscii client:visible src={sitePath("/tung-tung-tung-sahur.webp")} />
        </button>
        <p class="guardian-hint mono">Hover to see him. Click to knock.</p>
      </div>
      <div>
        <p class="eyebrow">04 / The guardian</p>
        <h2 id="guardian-title">Yes, the mascot<br />is a log with a bat.</h2>
        <p class="lede">The app hides 20 discoveries behind a ☾ in the corner, and there's a drum room you can switch off. This page hides six more. None of them get in the way of work.</p>
        <div class="secrets" id="secrets">
          <button id="secret-moon" type="button" aria-label="Tap the moon">☾</button>
          <div>
            <p class="mono"><strong id="site-secret-count">0</strong> / 6 secrets found</p>
            <p id="site-secret-status" role="status" aria-live="polite">The village is listening.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Install -->
  <section id="install" class="section" aria-labelledby="install-title">
    <div class="wrap install-grid">
      <div>
        <p class="eyebrow">05 / Install</p>
        <h2 id="install-title">Four commands<br />to the village.</h2>
        <ul class="checklist">
          <li><b>Node 26.12.1</b> and <b>pnpm 12.14.0</b>, as pinned in package.json.</li>
          <li><b>One agent CLI</b> logged in: Claude Code, Codex, Cursor, OpenCode, Grok or Antigravity.</li>
          <li><b>macOS, Windows or Linux.</b> It runs in your browser or as a desktop app.</li>
        </ul>
        <a class="text-link" href={sitePath("/download/")}>Full setup and troubleshooting →</a>
      </div>
      <div class="term" role="group" aria-label="Install commands">
        <div class="term-bar"><i></i><i></i><i></i><span class="mono">zsh</span><button type="button" class="copy" data-copy="#install-cmds">Copy</button></div>
        <pre class="mono" id="install-cmds"><span class="c"># clone the village</span>
git clone {GITHUB_REPOSITORY_URL}.git
cd tung-tung-tung-code
pnpm install
pnpm dev <span class="c"># tung tung tung</span></pre>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <header>
        <p class="eyebrow">06 / Questions</p>
        <h2 id="faq-title">Fair questions.</h2>
        <p class="lede">Not backed by Y Combinator. Not backed by anyone. Built in public by people who should be asleep.</p>
      </header>
      <div class="faq">
        {faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta" aria-labelledby="cta-title">
    <div class="cta-glow" aria-hidden="true"><DawnGlow client:visible /></div>
    <div class="wrap cta-inner">
      <h2 id="cta-title">Dawn is coming.<br />Ship before it.</h2>
      <div class="hero-actions">
        <a class="btn" href={sitePath("/download/")}>Get started, free</a>
        <a class="btn btn-ghost" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">Star on GitHub</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { KNOCK_PATTERNS, playKnocks } from "../lib/knock";

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-knock]")) {
    button.addEventListener("click", () => playKnocks(KNOCK_PATTERNS[button.dataset.knock === "completion" ? "completion" : "input"]));
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      const source = document.querySelector(button.dataset.copy ?? "");
      const text = (source?.textContent ?? "").split("\n").map((l) => l.replace(/\s+#.*$/, "")).filter((l) => l && !l.startsWith("#")).join("\n");
      try { await navigator.clipboard.writeText(text); button.textContent = "Copied"; }
      catch { button.textContent = "Select to copy"; }
      setTimeout(() => (button.textContent = "Copy"), 1800);
    });
  }

  // Six website secrets. Progress lives in page memory only.
  const found = new Set<string>();
  let knocks = 0;
  let moons = 0;
  let buffer: string[] = [];
  const status = document.getElementById("site-secret-status");
  const count = document.getElementById("site-secret-count");
  function discover(key: string, message: string) {
    if (found.has(key)) return;
    found.add(key);
    if (status) status.textContent = message;
    if (count) count.textContent = String(found.size);
  }
  document.getElementById("guardian-knock")?.addEventListener("click", () => {
    knocks += 1;
    playKnocks(knocks % 3 === 0 ? KNOCK_PATTERNS.input : KNOCK_PATTERNS.completion);
    if (status && !found.has("knock")) status.textContent = `${knocks} knock${knocks === 1 ? "" : "s"}. The village is listening.`;
    if (knocks === 3) discover("knock", "Three knocks. The guardian knows you now.");
    if (knocks === 33) discover("marathon", "33 knocks. You have been promoted to village supervisor.");
  });
  document.getElementById("secret-moon")?.addEventListener("click", () => {
    moons += 1;
    if (moons === 7) discover("moon", "Seven moon taps. One very patient moon.");
  });
  document.addEventListener("keydown", (event) => {
    if (event.isComposing || event.repeat || event.ctrlKey || event.metaKey || event.altKey || (event.target instanceof Element && event.target.closest("input, textarea, select, [contenteditable]:not([contenteditable='false'])"))) { buffer = []; return; }
    buffer = [...buffer, event.key.length === 1 ? event.key.toLowerCase() : event.key].slice(-12);
    const joined = buffer.join("");
    if (joined.endsWith("sahur")) discover("chant", "SAHUR! The whole village heard that.");
    if (joined.endsWith("tungtungtung")) { playKnocks(); discover("rhythm", "+1,000 wooden aura. Deploy responsibly."); }
    if (buffer.slice(-10).join(" ") === "ArrowUp ArrowUp ArrowDown ArrowDown ArrowLeft ArrowRight ArrowLeft ArrowRight b a") discover("konami", "Ancient ritual complete. The wooden council approves.");
  });
</script>

<style>
  /* Hero */
  .hero { position: relative; padding-top: 150px; overflow: hidden; isolation: isolate; }
  .hero-sky { position: absolute; inset: 0 0 auto; height: 980px; z-index: -2; }
  .hero-sky :global(> *) { position: absolute; inset: 0; }
  .hero-fade { position: absolute; inset: 0 0 auto; height: 980px; z-index: -1; background: radial-gradient(ellipse 44% 36% at 50% 33%, rgba(14,10,7,.9) 45%, rgba(14,10,7,0) 100%), linear-gradient(to bottom, rgba(14,10,7,.35), rgba(14,10,7,0) 30%, rgba(14,10,7,0) 70%, var(--bg)); }
  .hero-inner { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .yc-pill { display: inline-flex; align-items: center; gap: 10px; height: 34px; padding: 0 14px 0 5px; border-radius: 999px; font-size: 13px; color: var(--fg); background: rgba(26, 20, 14, 0.75); box-shadow: inset 0 0 0 1px var(--border-strong), 0 8px 30px rgba(0,0,0,.35); backdrop-filter: blur(8px); transition: box-shadow .2s, transform .2s; animation: rise .7s cubic-bezier(.2,.8,.2,1) both; }
  .yc-pill:hover { box-shadow: inset 0 0 0 1px rgba(242,101,34,.6), 0 8px 30px rgba(0,0,0,.35); transform: translateY(-1px); }
  .yc-mark { position: relative; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 6px; background: #f26522; color: #fff; font-weight: 600; font-size: 15px; overflow: hidden; }
  .yc-mark::after { content: ""; position: absolute; left: -4px; right: -4px; top: 50%; height: 2.5px; background: #1a1008; transform: rotate(-38deg); box-shadow: 0 0 0 1.5px #f26522; }
  .yc-sep { width: 1px; height: 14px; background: var(--border-strong); }
  .yc-alt { color: var(--fg-muted); }
  @media (max-width: 560px) { .yc-sep, .yc-alt { display: none; } }
  .hero-title { margin-top: 30px; font-size: clamp(48px, 8.4vw, 112px); line-height: 0.95; letter-spacing: -0.055em; font-weight: 600; text-wrap: balance; animation: rise .8s .08s cubic-bezier(.2,.8,.2,1) both; }
  .hero-title :global(span) { font-style: normal; }
  .hero-sub { margin-top: 26px; max-width: 640px; font-size: clamp(16px, 1.6vw, 19px); line-height: 1.55; color: var(--fg-muted); text-wrap: pretty; animation: rise .8s .16s cubic-bezier(.2,.8,.2,1) both; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 34px; animation: rise .8s .24s cubic-bezier(.2,.8,.2,1) both; }
  .hero .btn-ghost { background: rgba(14,10,7,.78); backdrop-filter: blur(6px); }
  .hero-facts { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 22px; margin-top: 26px; list-style: none; font-size: 11.5px; letter-spacing: .06em; color: var(--fg-dim); text-transform: uppercase; animation: rise .8s .3s cubic-bezier(.2,.8,.2,1) both; }
  .hero-facts li::before { content: "■ "; color: var(--accent); font-size: 8px; vertical-align: 2px; }
  .hero-shot { margin-top: 72px; perspective: 1800px; }
  .hero-shot .frame { transform: rotateX(5deg); transform-origin: 50% 0; animation: tilt 1.2s .35s cubic-bezier(.2,.8,.2,1) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } }
  @keyframes tilt { from { opacity: 0; transform: rotateX(22deg) translateY(50px); } }

  .frame { position: relative; border-radius: 16px; overflow: hidden; background: #120d09; box-shadow: 0 0 0 1px rgba(235,168,84,.22), 0 40px 120px -20px rgba(0,0,0,.8), 0 0 120px -30px rgba(235,168,84,.25); }
  .frame-bar { display: flex; align-items: center; gap: 7px; height: 34px; padding: 0 14px; background: #17110c; border-bottom: 1px solid var(--border); }
  .frame-bar i, .term-bar i { width: 10px; height: 10px; border-radius: 50%; background: #3a2d21; }
  .frame-bar span { margin-left: 10px; font-size: 12px; color: var(--fg-dim); }
  .frame img { width: 100%; height: auto; }

  /* Agents */
  .agents { padding: 72px 0 24px; }
  .agents-label { text-align: center; font-size: 11.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--fg-dim); }
  .agent-row { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 22px; }
  .agent-row li { display: flex; align-items: center; gap: 9px; height: 44px; padding: 0 16px; border-radius: 12px; background: var(--bg-elev); box-shadow: inset 0 0 0 1px var(--border); font-size: 14.5px; color: var(--fg-muted); }
  .agent-row img { width: 20px; height: 20px; }

  /* Sections */
  .section { padding: 120px 0 40px; }
  .section-head { max-width: 640px; margin-bottom: 48px; }
  .section-head-center { margin-inline: auto; text-align: center; }
  h2 { margin-top: 16px; font-size: clamp(36px, 5vw, 60px); line-height: 1; letter-spacing: -0.045em; font-weight: 600; text-wrap: balance; }
  .lede { margin-top: 18px; font-size: 17px; color: var(--fg-muted); max-width: 520px; text-wrap: pretty; }
  h3 { font-size: 19px; letter-spacing: -0.02em; font-weight: 600; }
  .card p, .news-card p { margin-top: 8px; font-size: 14.5px; line-height: 1.6; color: var(--fg-muted); }

  /* Bento */
  .bento { display: grid; grid-template-columns: repeat(12, 1fr); gap: 14px; }
  .card { grid-column: span 3; position: relative; padding: 26px; border-radius: var(--radius); background: linear-gradient(180deg, #1a140e, #140f0a); box-shadow: inset 0 0 0 1px var(--border); overflow: hidden; }
  .card-wide { grid-column: span 8; display: flex; flex-direction: column; padding-bottom: 0; }
  .card-tall { grid-column: span 4; display: flex; flex-direction: column; padding-bottom: 0; }
  .card-copy { max-width: 520px; }
  .card-shot { margin-top: 24px; margin-right: -26px; border-radius: 10px 0 0 0; overflow: hidden; box-shadow: 0 0 0 1px var(--border-strong); flex: 1; }
  .card-shot img { width: 100%; height: 100%; object-fit: cover; object-position: left top; }
  .card-shot-crop img { object-position: 100% top; min-height: 260px; }
