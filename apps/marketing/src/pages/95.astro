---
import Layout from "../layouts/Layout.astro";
import { sitePath } from "../lib/site";
---
<Layout title="Village OS 95 | Tung Tung Tung Code" description="A secret wooden desktop, hiding in plain sight.">
  <section class="retro"><p class="retro-tag">HIDDEN VILLAGE / LEGACY WOOD SUPPORT</p><div class="window"><div class="titlebar"><span>Village OS 95 — Wooden Edition</span><a href={sitePath("/")} aria-label="Close Village OS">×</a></div><div class="window-body"><img src={sitePath("/sahur.svg")} alt="Sahur guardian" width="100" height="100" /><h1>It is now safe<br />to awaken your computer.</h1><p>You found the secret desktop. No floppy disks were harmed.</p><button id="retro-knock">Knock.exe</button><p id="retro-status" role="status">Wooden drivers loaded successfully.</p><a href={sitePath("/download")}>Return to modern software →</a></div><div class="statusbar">20 secrets. 640 KB of wooden aura.</div></div><div class="taskbar"><strong>☾ Start</strong><span>Tung Tung Tung Code</span><time>03:33 AM</time></div></section>
</Layout>
<script>
  let knocks = 0;
  document.getElementById("retro-knock")?.addEventListener("click", () => {
    knocks += 1;
    const status = document.getElementById("retro-status");
    if (status) status.textContent = knocks % 3 === 0 ? "SAHUR.EXE has performed an entirely legal wooden operation." : `${"Tung. ".repeat(knocks % 3)}Please do not turn off the village.`;
  });
</script>
<style>
  .retro{position:relative;padding:45px 6% 100px;min-height:650px;background:#51644b;font-family:var(--font-mono)}.retro-tag{font-size:10px;letter-spacing:.14em;color:#efe7ca}.window{max-width:640px;margin:45px auto;background:#d3c8ae;color:#241b13;border:3px outset #e8ddc7;box-shadow:8px 8px 0 #21322070}.titlebar{padding:7px 12px;display:flex;justify-content:space-between;background:#62472e;color:#fff2d5;font-size:12px}.titlebar a{background:#d3c8ae;color:#241b13;padding:0 7px;text-decoration:none}.window-body{padding:35px;text-align:center}.window-body img{margin:0 auto 20px}.window-body h1{font-size:clamp(20px,4vw,29px);line-height:1.5}.window-body p,.window-body a{font-size:11px}.window-body button{padding:10px 25px;background:#d3c8ae;color:#241b13;border:3px outset #f2e8d2;font:14px var(--font-mono);margin:14px}.window-body button:active{border-style:inset}.statusbar{padding:6px;border-top:2px groove #eee1c8;font-size:9px}.taskbar{position:absolute;bottom:0;left:0;right:0;background:#d3c8ae;color:#241b13;border-top:3px outset #f2e8d2;padding:8px 14px;display:flex;align-items:center;gap:20px;font-size:11px}.taskbar strong{border:2px outset #eee1c8;padding:4px 14px}.taskbar time{margin-left:auto}#retro-status{min-height:34px}
</style>
