---
import "../styles/fonts.css";
import { GITHUB_REPOSITORY_URL, sitePath } from "../lib/site";
interface Props { title?: string; description?: string; socialImageAlt?: string }
const {
  title = "Tung Tung Tung Code: Wake up. Ship something legendary.",
  description = "A wooden-aura coding agent workspace. A Sahur-themed community fork with real tools, warm themes, and a suspicious number of secrets.",
  socialImageAlt = "Tung Tung Tung Code. The village is asleep. Your ideas aren't.",
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#241b13" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={sitePath("/sahur.svg")} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(sitePath("/sahur-social.png"), Astro.site ?? Astro.url).href} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/sahur-social.png" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href={sitePath("/")} aria-label="Tung Tung Tung Code home"><span aria-hidden="true">☾</span><span>TUNG TUNG TUNG<span class="wordmark-sub">CODE / WOODEN AURA EDITION</span></span></a>
      <nav aria-label="Main navigation"><a href={sitePath("/#workspace")}>The workspace</a><a href={sitePath("/#secrets")}>The lore</a><a href={sitePath("/download")}>Get the code ↗</a></nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <a class="footer-brand" href={sitePath("/")}>TUNG TUNG TUNG CODE<span>Code quietly. Carry a big stick.</span></a>
      <div><a href={GITHUB_REPOSITORY_URL}>Source on GitHub ↗</a><a href={sitePath("/legal")}>About this fork</a><a href={sitePath("/privacy-policy")}>Privacy</a><a href={sitePath("/95")} aria-label="A suspiciously old clock">03:33</a></div>
      <p>An independent community fork of <a href="https://github.com/pingdotgg/t3code">T3 Code</a>. Not affiliated with or endorsed by its maintainers. Original licenses and attribution preserved.</p>
    </footer>
  </body>
</html>
<style is:global>
  :root { color-scheme: dark; --bg: #241b13; --bg-card: #302319; --fg: #f4e9d7; --fg-muted: #c4ae91; --accent: #edb65c; --border: #64503a; --font-sans: "DM Sans", sans-serif; --font-mono: "JetBrains Mono", monospace; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 100px; }
  body { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--font-sans); line-height: 1.6; }
  a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  button, input { font: inherit; }
  button, a { -webkit-tap-highlight-color: transparent; }
  button { cursor: pointer; }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 6px; }
  img { max-width: 100%; display: block; }
  .skip { position: absolute; top: -100px; left: 20px; z-index: 100; padding: 12px; background: var(--fg); color: var(--bg); }
  .skip:focus { top: 12px; }
  .site-header { max-width: 1440px; margin: auto; min-height: 110px; padding: 26px 5%; display: flex; align-items: center; justify-content: space-between; gap: 24px; border-bottom: 1px solid var(--border); }
  .wordmark { display: flex; align-items: center; gap: 13px; font-size: 17px; line-height: 1.3; letter-spacing: -.04em; font-weight: 900; text-decoration: none; }
  .wordmark > span:first-child { color: var(--accent); font-size: 44px; }
  .wordmark-sub { display: block; font-size: 8px; letter-spacing: .2em; margin-top: 5px; color: var(--fg-muted); }
  nav { display: flex; gap: 28px; font-size: 13px; }
  nav a { text-decoration: none; }
  nav a:last-child { color: var(--accent); }
  .site-footer { max-width: 1440px; padding: 56px 5% 24px; margin: auto; border-top: 1px solid var(--border); display: grid; grid-template-columns: 1fr 1fr; gap: 36px; }
  .footer-brand { font-size: 20px; font-weight: 900; text-decoration: none; }
  .footer-brand span { display: block; color: var(--fg-muted); font-size: 13px; font-weight: 400; margin-top: 6px; }
  .site-footer > div { display: flex; gap: 24px; justify-content: flex-end; font-size: 12px; flex-wrap: wrap; }
  .site-footer > p { grid-column: 1 / -1; color: var(--fg-muted); font-size: 11px; max-width: 700px; }
  @media (max-width: 640px) { .site-header { min-height: 90px; padding: 20px 6%; } nav { gap: 16px; } nav a:not(:last-child) { display: none; } .wordmark { font-size: 14px; } .site-footer { grid-template-columns: 1fr; padding: 40px 6% 20px; } .site-footer > div { justify-content: flex-start; } }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { animation: none !important; transition: none !important; } }
</style>
