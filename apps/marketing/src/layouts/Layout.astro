---
import { getImage } from "astro:assets";
import socialCard from "../assets/social-card.webp";
import "../styles/fonts.css";
import "../styles/site.css";
import { GITHUB_REPOSITORY_URL, sitePath } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
}

const {
  title = "Tung Tung Tung Code: every coding agent, one workspace",
  description = "Run Claude Code, Codex, Cursor, OpenCode, Grok and Antigravity side by side in one open-source desktop workspace. Your subscriptions, your machine. Free and MIT licensed.",
  pageClass,
} = Astro.props;

// Link unfurlers require a 1200x630 JPG/PNG at an absolute URL.
const socialImage = await getImage({ src: socialCard, width: 1200, height: 630, format: "jpg", quality: 90 });
const socialImageUrl = new URL(socialImage.src, Astro.site ?? Astro.url);
const socialImageAlt =
  "Tung Tung Tung Code: the open-source control plane for coding agents, with Claude Code, Codex, Cursor, OpenCode, Grok and Antigravity.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Tung Tung Tung Code",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Windows, Linux",
  description,
  url: canonicalUrl.href,
  license: "https://opensource.org/licenses/MIT",
  codeRepository: GITHUB_REPOSITORY_URL,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
});
const nav = [
  { href: "/#features", label: "Features" },
  { href: "/#new", label: "What's new" },
  { href: "/#faq", label: "FAQ" },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e0a07" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tung Tung Tung Code" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" href={sitePath("/favicon.ico")} sizes="48x48" />
    <link rel="icon" type="image/png" href={sitePath("/favicon-32x32.png")} sizes="32x32" />
    <link rel="icon" type="image/png" href={sitePath("/favicon-16x16.png")} sizes="16x16" />
    <link rel="apple-touch-icon" href={sitePath("/apple-touch-icon.png")} />
    <link rel="sitemap" href={sitePath("/sitemap.xml")} />
    <script type="application/ld+json" set:html={structuredData} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class:list={["page", pageClass]}>
      <header class="nav" data-nav>
        <div class="nav-inner">
          <a href={sitePath("/")} class="brand" aria-label="Tung Tung Tung Code home">
            <img src={sitePath("/tung-tung-tung-sahur.webp")} width="26" height="26" alt="" />
            <span>Tung Tung Tung <b>Code</b></span>
          </a>
          <nav class="nav-links" aria-label="Primary">
            {nav.map((item) => <a href={sitePath(item.href)}>{item.label}</a>)}
            <a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
          </nav>
          <a class="btn btn-sm" href={sitePath("/download/")}>Get started</a>
        </div>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="footer">
        <div class="footer-inner">
          <div class="footer-brand">
            <img src={sitePath("/tung-tung-tung-sahur.webp")} width="22" height="22" alt="" loading="lazy" />
            <span>&copy; {new Date().getFullYear()} Tung Tung Tung Code contributors. MIT licensed.</span>
          </div>
          <nav class="footer-links" aria-label="Footer">
            <a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href={`${GITHUB_REPOSITORY_URL}/issues`} target="_blank" rel="noopener noreferrer">Issues</a>
            <a href={sitePath("/download/")}>Install</a>
            <a href={sitePath("/legal/")}>About this fork</a>
            <a href={sitePath("/privacy-policy/")}>Privacy</a>
            <a href={sitePath("/security-policy/")}>Security</a>
            <a href={sitePath("/95/")} aria-label="A suspiciously old clock">03:33</a>
          </nav>
        </div>
        <p class="footer-fine">
          An independent fork of <a href="https://github.com/pingdotgg/t3code" target="_blank" rel="noopener noreferrer">T3 Code</a>, not affiliated with or endorsed by its maintainers.
          Character image by @noxaasht via <a href="https://commons.wikimedia.org/wiki/File:Tung_tung_tung_sahur.webp" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>.
          Effects built with <a href="https://dithercn.dev" target="_blank" rel="noopener noreferrer">dithercn</a>, <a href="https://asciicn.sumak.dev" target="_blank" rel="noopener noreferrer">asciicn</a> and <a href="https://gradients.sh" target="_blank" rel="noopener noreferrer">gradients.sh</a> (MIT).
        </p>
      </footer>
    </div>

    <script>
      const nav = document.querySelector("[data-nav]");
      const onScroll = () => nav?.classList.toggle("is-scrolled", window.scrollY > 12);
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>
